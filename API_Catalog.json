      "version_macro": "ES_CAR_CONTROL_VERSION",
      "header": "ES_CarControl/ES_CarControl.h",
      "role": "Controle de veiculos com ponte H, incluindo movimento, luzes, buzina e comandos seriais.",
      "construction": "ES_CarControl car(expander);",
      "dependencies": ["ES_PCF8574", "ES_Buzzer optional"],
      "constants": ["DIFFERENTIAL", "FRONTAL"],
      "motor_defaults": {
        "default_control_class": "ES_CarControl",
        "default_expander": "ES_PCF8574 expander(0x20)",
        "h_bridge_terminal": "Borne azul da ponte H da ES32Lab",
        "controlled_by": "Expansor I2C onboard PCF8574",
        "physical_connection": "A ponte H onboard e ligada ao expansor I2C por jumpers brancos da propria ES32Lab.",
        "jumper_video": "https://www.youtube.com/watch?v=xpoNbSA8pPM&list=PLpVVewmHgD_LDEXAvsAxDWjS-3XCfZlZi&index=18&t=383s",
        "differential_default_begin": "car.begin(DIFFERENTIAL)",
        "differential_default_pins": {
          "motor_index_0": ["EX4", "EX5"],
          "motor_index_1": ["EX6", "EX7"]
        },
        "manual_pin_equivalent": "car.begin(DIFFERENTIAL, EX4, EX5, EX6, EX7, ...)",
        "generation_rule": "Quando o usuario pedir codigo com motores, carro, robo movel, ponte H ou veiculo, gerar por padrao com ES_CarControl em vez de controlar a ponte H manualmente.",
        "invert_motor_commands": {
          "first_motor_physical_output": "car.invertMotorCommands(0)",
          "second_motor_physical_output": "car.invertMotorCommands(1)",
          "warning": "Os indices da classe sao 0 e 1. Nao confundir com legendas antigas impressas na placa."
        },
        "legacy_board_label_warning": {
